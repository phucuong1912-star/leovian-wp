# Leovian — WordPress site
# Tracks the site's own code (theme "leovian" and any added plugins).
# WordPress core, secrets, media uploads and logs stay out of git.
# Want WordPress core in the repo too? Delete the "WordPress core" block below.

# --- WordPress core (download from wordpress.org) ---
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/xmlrpc.php
/wp-*.php
!/wp-config-sample.php
/wp-content/index.php
/wp-content/plugins/index.php
/wp-content/themes/index.php

# --- Secrets: DB password and security keys ---
wp-config.php
.env
*.pem
*.key

# --- Bundled themes, plugins and language packs we do not use ---
/wp-content/themes/twenty*/
/wp-content/plugins/hello.php
/wp-content/plugins/akismet/
/wp-content/languages/

# --- Generated by WordPress ---
/.htaccess
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/cache/
/wp-content/backup*/
/wp-content/advanced-cache.php
/wp-content/object-cache.php

# --- Logs and database dumps ---
*.log
*.sql
*.sql.gz
*.sqlite

# --- OS / editor clutter ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
node_modules/
