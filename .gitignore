# Leovian — WordPress site
# Tracks the whole site (WordPress core, theme, plugins) so a push can deploy it.
# Secrets, media uploads, server-specific files and logs stay out of git.

# --- Secrets: DB password and security keys (each server keeps its own) ---
wp-config.php
.env
*.pem
*.key

# --- Server-specific: rewrite rules differ per host (/LeoVian/ here, / on InfinityFree) ---
/.htaccess

# --- Media and files WordPress writes at runtime ---
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/cache/
/wp-content/backup*/
/wp-content/advanced-cache.php
/wp-content/object-cache.php

# --- Logs and database dumps ---
*.log
*.sql
*.sql.gz
*.sqlite

# --- OS / editor clutter ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
node_modules/
